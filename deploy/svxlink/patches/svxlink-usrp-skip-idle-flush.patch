--- a/src/svxlink/svxlink/contrib/UsrpLogic/UsrpLogic.cpp
+++ b/src/svxlink/svxlink/contrib/UsrpLogic/UsrpLogic.cpp
@@ -743,15 +743,43 @@ void UsrpLogic::handleVoiceStream(UsrpAudioMsg usrp)
   {
     m_audio_data[i] = ntohs(usrp.audioData()[i]);
   }
-  m_dec->writeEncodedSamples(&m_audio_data, 
-                        sizeof(int16_t)*USRP_AUDIO_FRAME_LEN);
+
+  // Keep one frame back and require three continuous frames before
+  // publishing anything to the linked logic. Short stale stream tails must
+  // not become a new DStarBridge talker on SvxReflector.
+  m_pending_incoming_audio.push_back(m_audio_data);
+  if (!m_incoming_audio_established)
+  {
+    if (m_pending_incoming_audio.size() < 3)
+    {
+      return;
+    }
+    m_incoming_audio_established = true;
+  }
+  while (m_pending_incoming_audio.size() > 1)
+  {
+    const auto& frame = m_pending_incoming_audio.front();
+    m_dec->writeEncodedSamples(const_cast<int16_t*>(frame.data()),
+        sizeof(int16_t)*USRP_AUDIO_FRAME_LEN);
+    m_pending_incoming_audio.pop_front();
+  }
 } /* UsrpLogic::handleVoiceStream */
 
 
 void UsrpLogic::handleStreamStop(void)
 {
-  m_dec->flushEncodedSamples();
+  m_pending_incoming_audio.clear();
+  // URFD sends a key-up after every source stream. If no PCM was delivered
+  // toward the linked logic, flushing the decoder still creates a flush-only
+  // audio event. DStarBridge turns that into a zero-length local talker on
+  // SvxReflector under this node's callsign. Only flush an actually active
+  // inbound audio stream.
+  if (m_logic_con_out->isActive())
+  {
+    m_dec->flushEncodedSamples();
+  }
   checkIdle();
+  m_incoming_audio_established = false;
   m_enc->allEncodedSamplesFlushed();
   timerclear(&m_last_talker_timestamp);
 
@@ -936,6 +964,8 @@ void UsrpLogic::handleTimerTick(Async::Timer *t)
     if (diff.tv_sec > 3)
     {
       cout << name() << ": Last talker audio timeout" << endl;
+      m_pending_incoming_audio.clear();
+      m_incoming_audio_established = false;
       m_dec->flushEncodedSamples();
       timerclear(&m_last_talker_timestamp);
     }
