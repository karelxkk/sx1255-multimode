+// SendSMS builds an M17 SMS and sends it to every client of the bridge module,
+// so the connected repeater transmits it on RF.  It deliberately bypasses the
+// APRS module: a message from the dashboard is an RF transmission, not an APRS
+// message, and it must not be relayed to APRS-IS twice.
+func (b *Bridge) SendSMS(to, text string) error {
+	if len(b.server.ClientsByModule(b.module)) == 0 {
+		return web.ErrNoClients
+	}
+	p, err := m17.NewPacket(to, b.defaultSource, m17.PacketTypeSMS, append([]byte(text), 0))
+	if err != nil {
+		return fmt.Errorf("%w: %v", web.ErrBadCallsign, err)
+	}
+	b.server.SendPacketToModule(b.module, p)
+	return nil
 }
 
