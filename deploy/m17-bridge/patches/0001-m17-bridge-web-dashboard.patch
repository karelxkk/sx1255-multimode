+// Recorder receives every message the bridge handles.  It is an interface so
+// that the web dashboard can be wired in without the module depending on it.
+type Recorder interface {
+	Record(MessageRecord)
+}
+
+// APRSUser is a radio that has registered with the APRS module by sending a
+// message; the module then follows its APRS traffic.
+type APRSUser struct {
+	M17       string `json:"m17"`
+	APRS      string `json:"aprs"`
+	LastHeard string `json:"last_heard"`
+}
+
+// APRSStatus is a snapshot of the APRS-IS link and its registered users.
+type APRSStatus struct {
+	Server    string     `json:"server"`
+	Callsign  string     `json:"callsign"`
+	Connected bool       `json:"connected"`
+	Filter    string     `json:"filter"`
+	Users     []APRSUser `json:"users"`
+}
+
+// SetRecorder installs the message recorder.  It must be called before the
+// module starts handling traffic.
+func (m *APRSModule) SetRecorder(r Recorder) {
+	m.recorder = r
+}
+
+// record stores a message for the dashboard and logs it at INFO level, so
+// message traffic is visible in the journal without enabling DEBUG.
+func (m *APRSModule) record(rec MessageRecord) {
+	if rec.Module == "" {
+		rec.Module = string(m.name)
+	}
+	if rec.Status == "" {
+		rec.Status = "sent"
+	}
+	if m.recorder != nil {
+		m.recorder.Record(rec)
+	}
+	log.Printf("[INFO] %s %s>%s: %q (%s)", strings.ToUpper(rec.Direction), rec.Src, rec.Dst, rec.Text, rec.Status)
+}
+
+// Status returns the current APRS-IS link state and the registered users.
+func (m *APRSModule) Status() APRSStatus {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	st := APRSStatus{
+		Server:    m.serverName,
+		Callsign:  m.callsign,
+		Connected: m.conn != nil,
+		Filter:    m.buildFilter(),
+		Users:     []APRSUser{},
+	}
+	for cs, u := range m.users {
+		st.Users = append(st.Users, APRSUser{
+			M17:       cs,
+			APRS:      u.aprsCallsign,
+			LastHeard: u.lastHeard.UTC().Format(time.RFC3339),
+		})
+	}
+	sort.Slice(st.Users, func(i, j int) bool { return st.Users[i].M17 < st.Users[j].M17 })
+	return st
+}
