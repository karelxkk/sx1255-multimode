+func TestNormalizeCallsign(t *testing.T) {
+	cases := []struct {
+		in   string
+		want string
+		ok   bool
+	}{
+		{"ok1abc", "OK1ABC", true},
+		{" OK1ABC ", "OK1ABC", true},
+		{"OK1ABC-7", "OK1ABC 7", true},
+		{"OK1ABC 7", "OK1ABC 7", true},
+		{"DL1ABC", "DL1ABC", true},
+		{"OK1ABC-77", "OK1ABC 77", true},
+		{"OK1ABC-", "OK1ABC", true},
+		{"", "", false},
+		{"nonsense", "", false},
+		{"OK1ABC-777", "", false},
+	}
+	for _, tc := range cases {
+		got, err := normalizeCallsign(tc.in)
+		if tc.ok && err != nil {
+			t.Errorf("normalizeCallsign(%q) returned %v", tc.in, err)
+			continue
+		}
+		if !tc.ok {
+			if err == nil {
+				t.Errorf("normalizeCallsign(%q) unexpectedly accepted %q", tc.in, got)
+			}
+			continue
+		}
+		if got != tc.want {
+			t.Errorf("normalizeCallsign(%q) = %q, want %q", tc.in, got, tc.want)
+		}
+	}
+}
