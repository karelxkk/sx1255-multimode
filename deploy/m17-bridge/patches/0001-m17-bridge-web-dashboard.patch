+// ClientInfo describes one client connected to a module.  It is a snapshot,
+// mainly for management interfaces such as the bridge's web dashboard.
+type ClientInfo struct {
+	Callsign   string `json:"callsign"`
+	Module     string `json:"module"`
+	Addr       string `json:"addr"`
+	ListenOnly bool   `json:"listen_only"`
+}
+
+// Clients returns a snapshot of all connected clients, sorted by address.
+func (s *Server) Clients() []ClientInfo {
+	s.mutex.Lock()
+	defer s.mutex.Unlock()
+	return s.clientsLocked(0)
+}
+
+// ClientsByModule returns a snapshot of the clients linked to module m.
+func (s *Server) ClientsByModule(m byte) []ClientInfo {
+	s.mutex.Lock()
+	defer s.mutex.Unlock()
+	return s.clientsLocked(m)
+}
+
+// clientsLocked snapshots s.clients; module 0 means "any module".
+func (s *Server) clientsLocked(module byte) []ClientInfo {
+	out := make([]ClientInfo, 0, len(s.clients))
+	for _, c := range s.clients {
+		if c.module == nil {
+			continue
+		}
+		name := c.module.Name()
+		if module != 0 && name != module {
+			continue
+		}
+		out = append(out, ClientInfo{
+			Callsign:   c.callsign,
+			Module:     string(name),
+			Addr:       c.addr.String(),
+			ListenOnly: c.listenOnly,
+		})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Addr < out[j].Addr })
+	return out
+}
