# sx1255-multimode – ukázková konfigurace
#
# Po úpravě restartuj službu:
#   sudo systemctl restart sx1255-multimode

frontend:
  # sx1255 = reálný SX1255 HAT, null = bez rádia, replay = IQ soubor
  type: sx1255
  rx_freq: 430975000          # RX 430.975 MHz
  tx_freq: 438575000          # TX 438.575 MHz
  tx_power: 10                # výkon v dBm (0-10)
  squelch: -55                # RSSI práh pro FM (dBFS z výkonu IQ)
  block_size: 2048            # počet IQ vzorků na blok

  spi:
    device: /dev/spidev0.0    # SPI sběrnice k SX1255
    speed: 500000             # SPI clock

  gpio:
    chip: /dev/gpiochip0     # gpiochip pro reset/PTT
    reset: 25                 # BCM GPIO25 = reset SX1255
    # Tento HAT (B2) používá jen reset na GPIO25. RX/TX přepíná čip přes SPI.
    # Externí PA/LNA linky jsou proto -1 (nezapojeno):
    #   tx_enable = enable/bias externího PA nebo přepnutí RF cesty do TX
    #   rx_enable = enable RX cesty / LNA
    #   ptt       = vlastní klíčování externí PA (PTT)
    # V aktuálním kódu se tx_enable a ptt přepínají společně při setPtt().
    # Když má PA jen jeden ovládací vstup, použij ptt a tx_enable nech -1.
    # Pozor: GPIO18 je I2S BCLK a nesmí se použít jako PTT.
    tx_enable: -1
    rx_enable: -1
    ptt: -1

  alsa:
    capture: hw:SX1255I2S,1,0    # I2S RX, 125 kSa/s stereo IQ
    playback: hw:SX1255I2S,0,0   # I2S TX, 125 kSa/s stereo IQ

  lna_gain: 42                # RX LNA zisk
  pga_gain: 0                 # RX PGA zisk
  dac_gain: -3                # TX DAC útlum
  mixer_gain: -12             # TX mixer

modes:
  fm:
    enabled: true             # zapnout FM plugin
    # Detekce nosné je RSSI, bez CTCSS. Práh se bere z frontend.squelch.
    # FM smí převzít kanál až po této době nad prahem, aby M17/D-Star stihly
    # detekovat a FM krátce neklíčoval SVXLink na digitální nosné.
    squelch_hold_ms: 700      # doba RSSI nad prahem, než FM otevře
    # 0 = multimode tón na TX negeneruje.  Při backendu svxlink ho generuje
    # SVXLink sám (TX_CTCSS=ALWAYS a CTCSS_LEVEL v sekci [Tx1]); při backendu
    # local si tón musí vyrobit multimode, proto tam patří 88.5.
    ctcss_tx: 0               # CTCSS tón generovaný na TX (88.5 pro local)
    hang_time_ms: 3000        # dojezd po ztrátě nosné; při backendu svxlink
                              # nastav na SVXLink IDLE_TIMEOUT (typicky 10000)

    # backend: local  = multimode sám dělá FM převaděč (CTCSS RX/TX, hang)
    # backend: svxlink = multimode je jen RF<->audio bridge, logiku, squelch,
    #                    CTCSS a síť dělá SVXLink
    backend: local

    svxlink:
      audio_capture: plughw:Loopback,1,0     # TX audio ze SVXLinku
      audio_playback: plughw:Loopback,0,1    # RX audio do SVXLinku
      pty: /run/svxlink/ptt                  # SVXLink PTT_TYPE=PTY
      sql_pty: /run/svxlink/sql              # SQL PTY
      sql_pty_owner: svxlink                 # vlastník slave PTY
      audio_rate: 16000
      # Deviation: NFM 12.5 kHz = 2500 Hz, WFM 25 kHz = 5000 Hz.
      # tx_dev_hz je referenční deviation, tx_gain je jemná korekce.
      # Když vstupní stanice přemodulovává (špičky nad rx_max_dev_hz), audio
      # se v multimode ořezává - ořez signálu s CTCSS tónem vyrábí jeho
      # harmonické a ty je slyšet jako brum.  Řešení: zvýšit rx_max_dev_hz
      # (hlava) a úměrně tx_gain, aby deviation na TX zůstala.
      rx_max_dev_hz: 2500                   # RX max. deviation (WFM: 5000)
      tx_dev_hz: 2500                       # TX max. deviation (WFM: 5000)
      tx_gain: 1.75
      # Zvukové tvarování: NFM 12.5 kHz = 3000 Hz / 75 us,
      # WFM 25 kHz = cca 4500-5000 Hz a pre/de-emfáze dle normy (často 50 us).
      # Emfázi dělá multimode, protože jen on ví o úrovňovém omezení před
      # modulátorem: preemfáze za ořezem nezpůsobí zkreslení, kdežto uvnitř
      # SVXLinku (PREEMPHASIS=1) špičky ořezává jeho výstup (naměřeno 0 dBFS).
      # V SVXLinku proto patří DEEMPHASIS=0 a PREEMPHASIS=0.
      rx_deemph_us: 100           # RX de-emfáze (WFM často 50)
      tx_preemph_us: 75           # TX pre-emfáze (WFM často 50)
      rx_audio_lpf_hz: 2600       # RX audio LPF (WFM: 4500-5000)
      tx_audio_lpf_hz: 3000       # TX audio LPF (WFM: 4500-5000)
      # Horní propust na RX audiu odstraní subtón 88,5 Hz i nízké harmonické
      # klíčovaného generátoru z audia, které jde do SVXLinku.  Detekci nosné
      # dělá multimode šumově a otevírá SVXLinku SQL PTY, takže v SVXLinku
      # patří SQL_DET=PTY a subtón v audiu detekci nevadí.
      #   0   = tón zůstává v audiu
      #   ~300 = subtón se filtruje
      rx_highpass_hz: 0           # RX horní propust (0 = subtón nefiltrovat)

    # CTCSS na TX v backendu svxlink generuje SVXLink:
    #   [RepeaterLogic]/[ReflectorLogic] TX_CTCSS=ALWAYS
    #   [Tx1] CTCSS_FQ=88.5, CTCSS_LEVEL=-24

  dstar:
    enabled: true             # zapnout D-Star plugin
    callsign: OK1LBC           # RPT1/RPT2 pro lokální převaděč
    tx_preamble_bytes: 210
    tx_tail_ms: 50

    gateway:
      enabled: false           # DSRP gateway (DStarGateway/ircDDBGateway)
      address: 127.0.0.1
      port: 20010              # repeater -> gateway
      local_address: 127.0.0.1
      local_port: 20011        # gateway -> repeater
      name: sx1255-multimode

  m17:
    enabled: true             # zapnout M17 plugin
    callsign: OK1LBC
    # --- Příjem packetů (SMS, poloha) -----------------------------------
    # Prahy synchronizace jsou euklidovské vzdálenosti v symbolové doméně
    # (ideální symboly jsou +-3), takže nižší hodnota = přísnější.  Naměřeno
    # na reálném signálu z OpenRTX: skutečné LSF mají 1,4-4,4, rámce 2,7-3,8
    # a cokoliv, co sync slovo není, zůstává nad ~11,5 - výchozí hodnoty leží
    # v této mezeře.
    sync_lsf_threshold: 7.5      # preamble + LSF sync
    sync_packet_threshold: 5.0   # packet sync + následující rámec
    sync_stream_threshold: 5.0   # stream sync + následující rámec
    sync_eot_threshold: 4.5      # značka konce přenosu
    sync_lsf_sync_threshold: 4.5 # samotné LSF sync slovo (opakovaný pokus rádia
                                 # neposílá preamble znovu)
    sync_follow_threshold: 4.5   # samotný packet sync uvnitř packet přenosu
    # Počet sync burstů v 500 ms, po kterém se M17 vyhlásí jako aktivní mód.
    # Slouží jen k rozhodnutí, kdo vlastní kanál - dekódování packetů na tom
    # nezávisí, takže krátká SMS se neztratí.
    min_sync_burst: 5
    idle_timeout_ms: 1500        # konec M17 relace po tichu
    rssi_gate_dbfs: -55.0        # pod touto úrovní M17 nepřevezme mód
                                 # (dekódování packetů běží dál)
    # Diagnostika: vypsat každý detekovaný sync burst (typ, vzdálenost, stav
    # dekodéru). Zapnout jen pro test s reálným rádiem - LSF a packet rámce se
    # logují vždy, stream bursty nejvýš 1x za sekundu.
    log_sync: false
    # Diagnostika reálného vysílání. Candidate log je rotovaný textový soubor
    # s RSSI, AFC korekcí, SyncDistance a výsledkem každého zachyceného pokusu.
    # Zapisuje se jen při zapnutém hardware testu; nemění AFC ani sync prahy.
    diagnostics:
      candidate_log: false
      candidate_log_file: /var/lib/sx1255-multimode/m17_candidates.log
      candidate_log_max_bytes: 1048576
      candidate_log_backups: 3
      # Podrobný audit každého syncu: softbit RMS, Viterbi metric, Golay,
      # CRC a LSF výsledek. Rotace 1 MB / 3 zálohy.
      frame_audit_log: false
      frame_audit_log_file: /var/lib/sx1255-multimode/m17_frame_audit.log
      frame_audit_log_max_bytes: 1048576
      frame_audit_log_backups: 3
      # Sem se ukládají softbit_stats.json a artefakty rámců s CRC fail.
      audit_directory: /var/lib/sx1255-multimode/m17_audit
      near_miss_min_distance: 4.5
      near_miss_max_distance: 7.0
      near_miss_rssi_dbfs: -55.0
      near_miss_interval_ms: 100
    # Packety ze sítě čekají na volný kanál ve frontě (místo zahození).
    network_packet_queue: 8
    network_packet_ttl_ms: 2000
    bridge:
      enabled: false          # m17-bridge pro APRS zprávy a polohu
      host: 127.0.0.1         # kde běží m17-bridge
      port: 17001             # UDP port m17-bridge (mimo mrefd 17000)
      module: A               # modul s APRS bridge
    reflector:
      enabled: false           # připojit se k M17 reflektor
      # Pro M17 bridge (APRS zprávy a poloha) nasměruj host/port/module
      # na běžící m17-bridge s APRS modulem, viz docs/M17_BRIDGE.md.
      host: reflector.example.org  # adresa reflektoru
      port: 17000             # UDP port reflektoru
      module: A               # modul reflektoru

# Síťový zdroj pro směr síť -> RF:
#   auto  = použije se naposledy použitý lokální mód
#   dstar = vždy D-Star gateway
#   m17   = vždy M17 reflektor
#   fm    = vždy SVXLink
network:
  mode: auto

# Úspora CPU v klidovém DETECTING režimu. Při IQ výkonu pod sleep_below_dbfs
# se pozastaví pluginy FM/D-Star/M17; SX1255, IQ čtení, FFT a vodopád běží dál.
# Posledních prebuffer_ms vzorků se při probuzení přehraje detektorům před
# aktuálním blokem, aby digitální detekce neztratila začátek signálu.
# Jakmile blok překročí wake_above_dbfs, detekce okamžitě pokračuje. Mezi
# prahy je hystereze, aby se režim nekmitel na šumu.
power_save:
  enabled: false
  sleep_below_dbfs: -57.0
  wake_above_dbfs: -55.0
  prebuffer_ms: 250.0

# Záznam živého IQ do souboru.
recording:
  enabled: false              # zapnout záznam živého IQ
  file: capture.iq            # soubor pro záznam

# Přehrání IQ ze souboru místo reálného rádia.
replay:
  enabled: false              # přehrát IQ ze souboru místo rádia
  file: capture.iq            # soubor pro replay

# Diagnostika v prohlížeči: http://<ip>:8080/
spectrum:
  enabled: true               # zapnout spektrum/waterfall
  fft_size: 4096              # velikost FFT
  update_hz: 5                # obnovovací frekvence
  waterfall_rows: 500         # počet řádků historie
  waterfall_bins: 256         # počet binů waterfallu

# Automatické uložení IQ (pre + post okno) při podezřelé události.
automatic_capture:
  enabled: false              # zapnout automatický IQ capture
  directory: /var/lib/sx1255-multimode    # kam ukládat záznamy
  pre_seconds: 10             # kolik sekund před triggerem
  post_seconds: 10            # kolik sekund po triggeru
  trigger:
    false_positive: true      # trigger při falešné detekci
    unknown_signal: true      # trigger při neznámém signálu
    crash: true               # trigger při pádu
    m17_near_miss: true       # M17 sync 4.5-7.0 bez validního LSF/rámce
